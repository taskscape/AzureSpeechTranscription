<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Reason: NAudio selects its Media Foundation assemblies only for Windows target frameworks. -->
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.8.4" />
    <PackageReference Include="Microsoft.CognitiveServices.Speech" Version="1.52.0" />
    <PackageReference Include="NAudio" Version="3.1.0" />
    <PackageReference Include="YoutubeExplode" Version="6.6.2" />
  </ItemGroup>

</Project>
